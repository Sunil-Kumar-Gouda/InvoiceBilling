{
  "Infrastructure": {
    "Mode": "Standalone",
    "Standalone": {
      "PdfStoragePath": "App_Data/invoices",
      "MaxConcurrency": 2
    }
  },
  "BackgroundWorkers": {
    "InvoicePdfWorker": {
      "Enabled": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Auth": {
    "Enabled": true
  }
}
